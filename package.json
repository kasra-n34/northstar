{
  "name": "northstar",
  "version": "1.2.0",
  "description": "Northstar - Personal Development OS",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix northstar-frontend\" \"npm run dev --prefix northstar-backend\"",
    "electron:dev": "electron .",
    "start": "concurrently \"npm run dev --prefix northstar-frontend\" \"npm run dev --prefix northstar-backend\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build --prefix northstar-frontend",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.kasra.northstar",
    "productName": "Northstar",
    "asar": false,
    "publish": null,
    "files": [
      "electron/**/*",
      "northstar-frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "northstar-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**",
          "!.env",
          "!node_modules/.cache/**",
          "!node_modules/vitest/**",
          "!node_modules/@vitest/**",
          "!node_modules/@rolldown/**",
          "!node_modules/tinyrainbow/**",
          "!node_modules/tinypool/**",
          "!node_modules/vite/**",
          "!node_modules/@vite/**",
          "!node_modules/.bin/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 660,
        "height": 520
      },
      "contents": [
        {
          "x": 150,
          "y": 160
        },
        {
          "x": 510,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 330,
          "y": 310,
          "type": "file",
          "path": "build/CLICK ME FIRST.txt"
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}
